---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="End User License Agreement — IData"
  description="End User License Agreement for software applications provided by IData Corporation, including applications that integrate with Intuit QuickBooks."
  noindex={true}
>
  <Nav />
  <PageHeader
    headline="End User License Agreement"
    subheadline="The terms that govern your use of software applications provided by IData Corporation."
  />


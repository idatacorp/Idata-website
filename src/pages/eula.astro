<style>
  .policy {
    padding: 40px 0 120px;
  }

  .policy-content {
    max-width: 740px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .policy-updated {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .policy-content p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .policy-content h2 {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 24px;
    color: var(--text-primary);
  }

  .policy-content ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 24px;
  }

  .policy-content li {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .policy-content a {
    color: var(--accent);
    transition: opacity var(--transition-fast);
  }

  .policy-content a:hover {
    opacity: 0.8;
  }
</style>

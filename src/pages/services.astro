---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import OfferCard from '../components/OfferCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import { OFFERS, DATRIS_LICENSING_URL } from '../data/site';

const capabilities = [
  {
    title: 'Data Modernization & Lakehouse',
    desc: 'Cloud-native data platforms that agents and analysts can both use: data lakes, lakehouses, streaming ingestion, and the governance to go with them. Datris loads and governs beside the lake; it does not replace it.',
    deliverables: 'Cloud architecture, lake or lakehouse, ingestion pipelines, data catalog, security and compliance implementation',
    technologies: 'AWS, Azure, GCP, Databricks, Unity Catalog, Snowflake, Apache Iceberg, Kafka, Terraform',
  },
  {
    title: 'Data Quality & Governance',
    desc: 'Validation, profiling, deduplication, and field protection on every feed. Rules written in plain language, enforced on every record, with evidence of what passed and what did not.',
    deliverables: 'Validation rule set, profiling reports, protection policy for sensitive fields, catalog registration',
  },
  {
    title: 'AI Application Development',
    desc: 'The agent or application on top of the governed data: research assistants, operations copilots, document processing, retrieval over internal knowledge.',
    deliverables: 'Production application, governed tool access, evaluation suite, documentation',
    technologies: 'Anthropic, OpenAI, AWS Bedrock, Azure OpenAI, local models via Ollama, MCP',
  },
  {
    title: 'Advisory',
    desc: 'Short engagements for teams that need a plan before a build: data readiness for agents, platform selection, security and compliance design, roadmap.',
    deliverables: 'Assessment report, architecture blueprint, prioritized roadmap',
  },
];
---

<Layout
  title="Services — IData"
  description="Agent data integration services on Datris for financial institutions: assessment, fixed-scope implementation, and Run With You operations inside your infrastructure."
>
  <Nav />
  <PageHeader
    headline="Services"
    subheadline="We connect AI agents to governed financial data and stay accountable for the result. Three packaged offers, each scoped and priced on its own."
  />

  <section class="offers">
    <div class="container">
      <div class="section-label">Packaged Offers</div>
      <h2 class="section-title animate-on-scroll">Assess. Implement. Run With You.</h2>
      <p class="section-subtitle animate-on-scroll">
        Start with one workflow. Every stage ends with something you own, whether or not you continue to the next.
      </p>
      <div class="grid-3" style="margin-top: 40px;">
        {OFFERS.map((o, i) => (
          <OfferCard
            stage={o.stage}
            name={o.name}
            shape={o.shape}
            summary={o.summary}
            deliverables={o.deliverables}
            keep={o.keep}
            delay={i * 100}
          />
        ))}
      </div>
      <div class="offers-note animate-on-scroll">
        <p>
          <strong>Pricing.</strong> No number on this page, on purpose: an engagement is scoped to one workflow and one environment. Tell us the shape and we will reply with a proposal.
        </p>
        <p>
          <strong>Licensing.</strong> Datris is open source. If your organization requires a commercial license, that is sold separately through <a href={DATRIS_LICENSING_URL} target="_blank" rel="noopener">datris.ai</a>. Our services do not depend on it.
        </p>
        <a href="/contact?offer=assessment" class="btn btn-primary">Request a proposal &rarr;</a>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <section class="capabilities">
    <div class="container">
      <div class="section-label">Supporting Capabilities</div>
      <h2 class="section-title animate-on-scroll">What the offers are built from</h2>
      {capabilities.map((svc, i) => (
        <div class="service-block animate-on-scroll" style={`transition-delay: ${i * 80}ms`}>
          <h3 class="service-title">{svc.title}</h3>
          <p class="service-desc">{svc.desc}</p>
          <div class="service-meta">
            <div class="meta-item">
              <span class="meta-label">Deliverables</span>
              <span class="meta-value">{svc.deliverables}</span>
            </div>
            {svc.technologies && (
              <div class="meta-item">
                <span class="meta-label">Technologies</span>
                <span class="meta-value">{svc.technologies}</span>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <CtaBanner headline="Start with one workflow." buttonText="Request a proposal →" href="/contact?offer=assessment" />
  <Footer />
</Layout>

<style>
  .offers {
    padding: 40px 0 80px;
  }

  .offers-note {
    margin-top: 40px;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }

  .offers-note p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .offers-note strong {
    color: var(--text-primary);
  }

  .offers-note a:not(.btn) {
    color: var(--accent);
    font-weight: 600;
  }

  .offers-note .btn {
    margin-top: 8px;
  }

  .capabilities {
    padding: var(--section-padding);
  }

  .service-block {
    padding: 40px 0;
    border-bottom: 1px solid var(--border-color);
    max-width: 800px;
  }

  .service-block:last-child {
    border-bottom: none;
  }

  .service-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  .service-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .service-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .meta-item {
    display: flex;
    gap: 12px;
    font-size: 0.875rem;
  }

  .meta-label {
    font-weight: 600;
    color: var(--accent);
    min-width: 110px;
    flex-shrink: 0;
  }

  .meta-value {
    color: var(--text-secondary);
  }

  @media (max-width: 480px) {
    .meta-item {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
